# Google OAuth Web Client ID. Configure the authorized origin in Google Cloud Console.
GOOGLE_CLIENT_ID=replace-with-oauth-web-client-id.apps.googleusercontent.com

# Cloud SQL for PostgreSQL (Cloud Run service account needs Cloud SQL Client role).
INSTANCE_CONNECTION_NAME=project-id:asia-east1:instance-name
DB_NAME=xiaobei
DB_USER=xiaobei_app
DB_PASSWORD=load-from-secret-manager-not-git
DB_IP_TYPE=PUBLIC

# Set to the Cloud Run service URL, without a trailing slash.
PUBLIC_API_URL=https://your-cloud-run-service.run.app
QR_SIGNING_SECRET=generate-a-long-random-secret-and-store-in-secret-manager
ALLOWED_ORIGINS=https://qian03777.github.io
